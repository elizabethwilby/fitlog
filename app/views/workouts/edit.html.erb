<h1>Edit Workout</h1>

<%= form_for @workout do |f| %>
  <% if @workout.errors.any? %>
    <div>
      <h2><%= pluralize(@workout.errors.count, "error") %> prohibited this workout from being saved:</h2>
      <ul>
        <% @workout.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :notes %><br>
    <%= f.text_area :notes %>
  </div>

  <div>
    <%= f.submit "Update Workout" %>
    <%= link_to "Cancel", @workout %>
  </div>
<% end %>

