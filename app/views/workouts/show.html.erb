<h1><%= @workout.name %></h1>
<p><%= @workout.notes %></p>

<p>
  <%= link_to "Mark Complete", complete_workout_path(@workout), data: { turbo_method: :post } %> |
  <%= link_to "Edit", edit_workout_path(@workout) %> |
  <%= link_to "Delete", @workout, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
</p>

<h2>Exercises</h2>
<ul>
  <%= render @workout.workout_exercises %>
</ul>

<%= link_to "Add Exercise", new_workout_workout_exercise_path(@workout) %>

<p><%= link_to "Back to all workouts", workouts_path %></p>