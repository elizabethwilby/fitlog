<%= render "shared/error_messages", object: @workout %>

<%= form_for @workout do |f| %>
  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :notes %><br>
    <%= f.text_area :notes %>
  </div>

  <div>
    <%= f.submit %>
    <%= link_to "Cancel", @workout.persisted? ? @workout : workouts_path %>
  </div>
<% end %>