<h1>Add Exercise to <%= @workout.name %></h1>

<%= render "shared/error_messages", object: @workout_exercise %>

<%= form_for [@workout, @workout_exercise] do |f| %>

  <div>
    <%= f.label :exercise_id, "Exercise" %><br>
    <%= f.collection_select :exercise_id, Exercise.all, :id, :name %>
  </div>

  <div>
    <%= f.label :sets %><br>
    <%= f.number_field :sets %>
  </div>

  <div>
    <%= f.label :reps %><br>
    <%= f.number_field :reps %>
  </div>

  <div>
    <%= f.label :weight %><br>
    <%= f.number_field :weight, step: :any %>
  </div>

  <div>
    <%= f.label :duration_minutes %><br>
    <%= f.number_field :duration_minutes %>
  </div>

  <div>
    <%= f.label :distance %><br>
    <%= f.number_field :distance, step: :any %>
  </div>

  <div>
    <%= f.submit "Add Exercise" %>
    <%= link_to "Cancel", workout_path(@workout) %>
  </div>
<% end %>